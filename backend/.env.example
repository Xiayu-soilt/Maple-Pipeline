# DeepSeek API（AI 归因 / 流水线生成 / 报告）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# MySQL 用户库连接（首次启动自动建库建表）
MYSQL_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/maple_auth?charset=utf8mb4

# JWT 签名密钥（随机长字符串，命令：python -c "import secrets; print(secrets.token_hex(32))"）
JWT_SECRET=change-me-to-a-random-long-string
